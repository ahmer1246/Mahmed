<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>MA Devstudio</title>

    <meta name="description"
          content="MA Devstudio - Mobile App Development, Software Development and Digital Solutions.">

    <meta name="author" content="MA Devstudio">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f5f7fa;
            color: #222;
            line-height: 1.6;
        }

        header {
            background: #111827;
            color: white;
            padding: 20px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 24px;
            font-weight: bold;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin-left: 20px;
        }

        .hero {
            min-height: 70vh;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 40px 20px;
            background: white;
        }

        .hero h1 {
            font-size: 48px;
            margin-bottom: 15px;
        }

        .hero p {
            font-size: 20px;
            color: #555;
            max-width: 650px;
            margin: auto;
        }

        .btn {
            display: inline-block;
            margin-top: 25px;
            padding: 12px 25px;
            background: #2563eb;
            color: white;
            text-decoration: none;
            border-radius: 8px;
        }

        section {
            padding: 60px 8%;
            text-align: center;
        }

        .services {
            display: flex;
            justify-content: center;
            gap: 25px;
            flex-wrap: wrap;
            margin-top: 30px;
        }

        .card {
            background: white;
            padding: 30px;
            border-radius: 12px;
            width: 280px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        }

        .card h3 {
            margin-bottom: 10px;
        }

        footer {
            background: #111827;
            color: white;
            text-align: center;
            padding: 25px;
        }

        @media (max-width: 600px) {
            .hero h1 {
                font-size: 36px;
            }

            header {
                flex-direction: column;
                gap: 10px;
            }
        }
    </style>
</head>

<body>

<header>
    <div class="logo">MA Devstudio</div>

    <nav>
        <a href="#home">Home</a>
        <a href="#services">Services</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
    </nav>
</header>

<section class="hero" id="home">
    <div>
        <h1>MA Devstudio</h1>

        <p>
            We build modern mobile applications, websites
            and software solutions.
        </p>

        <a href="#services" class="btn">Our Services</a>
    </div>
</section>

<section id="services">
    <h2>Our Services</h2>

    <div class="services">

        <div class="card">
            <h3>Mobile App Development</h3>
            <p>
                Android and cross-platform mobile applications
                using modern technologies.
            </p>
        </div>

        <div class="card">
            <h3>Web Development</h3>
            <p>
                Responsive and modern websites for businesses
                and organizations.
            </p>
        </div>

        <div class="card">
            <h3>Software Solutions</h3>
            <p>
                Custom software solutions designed according
                to your requirements.
            </p>
        </div>

    </div>
</section>

<section id="about">
    <h2>About MA Devstudio</h2>

    <p>
        MA Devstudio is a software development studio focused
        on creating useful, reliable and user-friendly digital
        products.
    </p>
</section>

<section id="contact">
    <h2>Contact Us</h2>

    <p>
        Get in touch with MA Devstudio for your next project.
    </p>

    <a href="mailto:madevstudio@example.com" class="btn">
        Contact Us
    </a>
</section>

<footer>
    <p>© 2026 MA Devstudio. All Rights Reserved.</p>
</footer>

</body>
</html>
